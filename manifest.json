{
  "manifest_version": 3,
  "name": "LLM Usage Badge",
  "description": "Claude、Codex、Grok のサブスクリプション利用枠を確認します。",
  "version": "0.1.0",
  "action": {
    "default_title": "LLM Usage Badge",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*"
  ]
}

